# ─────────────────────────────────────────────────────────────────────────────
# ArtSpaces Design — environment contract
#
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored; THIS file is committed and must never contain real secrets.
#
# Validated by src/lib/env.ts. In production, a lead that cannot be delivered
# to at least one channel is reported to the visitor as a failure — it is never
# silently dropped.
# ─────────────────────────────────────────────────────────────────────────────

# ── Lead notification email (Resend) ─────────────────────────────────────────
# Get a key at https://resend.com/api-keys (free tier: 3,000 emails/month).
# All three must be set together for the email channel to be active.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where new enquiries are sent — the studio's real inbox.
LEAD_NOTIFY_TO=hello@artspaces.design

# The From address. Its domain must be verified in Resend.
# Until you verify a domain you can use: ArtSpaces <onboarding@resend.dev>
LEAD_NOTIFY_FROM=ArtSpaces Design <hello@artspaces.design>


# ── Durable lead record (webhook) ────────────────────────────────────────────
# Any endpoint that accepts a JSON POST: Zapier / Make / n8n / Google Apps
# Script / your own CRM. Optional, but strongly recommended — email alone means
# a deleted or filtered message is a permanently lost enquiry.
LEAD_WEBHOOK_URL=

# Optional. Sent as the `X-ArtSpaces-Signature` header so your endpoint can
# reject forged requests. Leave blank if your endpoint does not check it.
LEAD_WEBHOOK_SECRET=


# ── Site URL ─────────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash. Used by metadataBase, sitemap.ts and
# robots.ts (Phase 5). Safe to leave as localhost during development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
