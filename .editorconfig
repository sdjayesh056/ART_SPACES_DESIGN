# Codifies the indentation the repo already uses rather than reformatting it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[src/app/**.{ts,tsx,css}]
indent_size = 2

[src/{components,data,lib,types,actions}/**.{ts,tsx}]
indent_size = 4

[*.{json,yml,yaml,mjs}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
